{
  "$id": "loopscope.phase3.trajectory-record.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "boundaries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "boundary_id": {
            "pattern": "^B_([0-9]|1[0-9]|2[0-8])$",
            "type": "string"
          },
          "choice_distribution": {
            "items": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "choice_entropy": {
            "type": "number"
          },
          "cross_entropy_to_final": {
            "type": "number"
          },
          "kl_to_final": {
            "type": "number"
          },
          "top1_to_final_agreement": {
            "type": "boolean"
          }
        },
        "required": [
          "boundary_id",
          "choice_distribution",
          "choice_entropy",
          "cross_entropy_to_final",
          "kl_to_final",
          "top1_to_final_agreement"
        ],
        "type": "object"
      },
      "maxItems": 29,
      "minItems": 29,
      "type": "array"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "doc_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "doc_id": {
          "minLength": 1,
          "type": "string"
        },
        "task": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task",
        "doc_id",
        "doc_hash"
      ],
      "type": "object"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "renderer_provenance": {
      "additionalProperties": false,
      "properties": {
        "answer_position": {
          "const": "final_pre_answer_prompt_token"
        },
        "choice_order": {
          "const": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "dataset_repo": {
          "const": "cais/mmlu"
        },
        "dataset_revision": {
          "const": "c30699e8356da336a370243923dbaf21066bb9fe"
        },
        "formal_forward_count_per_identity": {
          "const": 1
        },
        "forward_type": {
          "const": "native_no_loop"
        },
        "loop_insertions": {
          "const": 0
        },
        "model_repo": {
          "const": "Qwen/Qwen3-1.7B-Base"
        },
        "model_revision": {
          "const": "ea980cb0a6c2ae4b936e82123acc929f1cec04c1"
        },
        "pool_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "projection": {
          "const": "raw_direct_logit_lens_through_frozen_final_norm_and_lm_head"
        },
        "renderer_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "tokenizer_revision": {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        }
      },
      "required": [
        "answer_position",
        "choice_order",
        "dataset_repo",
        "dataset_revision",
        "formal_forward_count_per_identity",
        "forward_type",
        "loop_insertions",
        "model_repo",
        "model_revision",
        "pool_manifest_sha256",
        "projection",
        "renderer_manifest_sha256",
        "source_manifest_sha256",
        "tokenizer_revision"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "loopscope.phase3.trajectory-record.v1"
    },
    "split": {
      "const": "validation"
    },
    "subject": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "boundaries",
    "identity",
    "prompt_sha256",
    "renderer_provenance",
    "schema_version",
    "split",
    "subject"
  ],
  "type": "object"
}
